//| Devuelve true si la hora actual está dentro de la franja operativa|
//+------------------------------------------------------------------+
bool IsTradingTime() {
   // Si GMTOffset = 0, el filtro horario está desactivado
   if( GMTOffset == 0 ) return( true );
   
   // Hora del servidor del bróker + ajuste GMT = hora "real" deseada
   int currentHour   = Hour()   + GMTOffset;
   int currentMinute = Minute();
   
   // Normalizar la hora si cruza el día
   if( currentHour >= 24 ) currentHour -= 24;
   if( currentHour < 0 )   currentHour += 24;
   
   // Convertir todo a minutos desde las 00:00 para comparar rangos
   int currentTimeMin = currentHour * 60 + currentMinute;
   int startTimeMin   = StartHour * 60 + StartMinute;
   int endTimeMin     = EndHour   * 60 + EndMinute;
   
   // Caso normal: la franja no cruza medianoche (ej. 1:00 → 23:00)
   if( startTimeMin <= endTimeMin ) {
      if( currentTimeMin >= startTimeMin && currentTimeMin <= endTimeMin ) return( true );
   } 
   // Caso especial: la franja cruza medianoche (ej. 22:00 → 02:00)
   else {
      if( currentTimeMin >= startTimeMin || currentTimeMin <= endTimeMin ) return( true );
   }
   
   return( false );
}

